# ── LLM Provider Keys ────────────────────────────────────────────────────────
# Set ONE of these. The provider is auto-detected from whichever key is present.
# Priority order: ANTHROPIC_API_KEY > OPENROUTER_API_KEY > GROQ_API_KEY

# Anthropic (Claude) — best tool-use support for the agentic loop
ANTHROPIC_API_KEY=

# OpenRouter — many models via an OpenAI-compatible API
OPENROUTER_API_KEY=

# Groq — fast inference, used in the original PoC
GROQ_API_KEY=

# Explicit provider + model override (optional — auto-detected if unset)
IFC_AGENT_LLM_PROVIDER=
IFC_AGENT_LLM_MODEL=

# ── Agentic loop ───────────────────────────────────────────────────────────────
IFC_AGENT_MAX_STEPS=15
IFC_AGENT_LLM_TIMEOUT_SECONDS=60

# ── MCP server ─────────────────────────────────────────────────────────────────
# Number of parsed IFC models to keep in the in-memory LRU cache
IFC_AGENT_MCP_MODEL_CACHE_SIZE=3

# ── PoC input ──────────────────────────────────────────────────────────────────
# Path to the IFC model the PoC scripts operate on (not shipped in this repo)
IFC_MODEL_PATH=tests/test_data/demo_model.ifc
